{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/remediation/probe-authoring-policy.schema.json",
    "title": "Probe Authoring Policy",
    "description": "Versioned authoring rules for resolving probe difficulty, required evidence, and optional question-type constraints.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "policyId",
        "policyVersion",
        "failureSignatureDefaults"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
        },
        "policyId": {
            "type": "string",
            "minLength": 1
        },
        "policyVersion": {
            "type": "string",
            "minLength": 1
        },
        "failureSignatureDefaults": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "minLength": 1
            },
            "additionalProperties": {
                "$ref": "#/$defs/probeConstraints"
            }
        },
        "targetNodeOverrides": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "targetNodeId",
                    "failureSignature"
                ],
                "properties": {
                    "targetNodeId": {
                        "type": "string",
                        "minLength": 1
                    },
                    "failureSignature": {
                        "type": "string",
                        "minLength": 1
                    },
                    "difficulty": {
                        "$ref": "#/$defs/difficulty"
                    },
                    "evidenceDimension": {
                        "$ref": "#/$defs/evidenceDimension"
                    },
                    "questionTypes": {
                        "$ref": "#/$defs/questionTypes"
                    }
                },
                "anyOf": [
                    {
                        "required": [
                            "difficulty"
                        ]
                    },
                    {
                        "required": [
                            "evidenceDimension"
                        ]
                    },
                    {
                        "required": [
                            "questionTypes"
                        ]
                    }
                ]
            }
        }
    },
    "$defs": {
        "difficulty": {
            "type": "string",
            "enum": [
                "D1",
                "D2",
                "D3",
                "D4",
                "D5"
            ]
        },
        "evidenceDimension": {
            "type": "string",
            "enum": [
                "know",
                "explain",
                "apply",
                "transfer"
            ]
        },
        "questionTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "mcq",
                    "multi_select",
                    "true_false",
                    "matching",
                    "ordering",
                    "fill_blank",
                    "short_answer",
                    "numeric",
                    "data_analysis",
                    "experiment",
                    "sequence",
                    "open_response"
                ]
            }
        },
        "probeConstraints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "difficulty",
                "evidenceDimension"
            ],
            "properties": {
                "difficulty": {
                    "$ref": "#/$defs/difficulty"
                },
                "evidenceDimension": {
                    "$ref": "#/$defs/evidenceDimension"
                },
                "questionTypes": {
                    "$ref": "#/$defs/questionTypes"
                }
            }
        }
    }
}
