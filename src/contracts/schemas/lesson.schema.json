{
    "schemaVersion": "1.0.0",
    "schemaId": "biology-lesson-schema-v1",
    "subject": "biology",
    "language": "vi",
    "status": "final",
    "purpose": {
        "description": "Schema chuẩn cho lesson học Sinh học theo knowledge node. Lesson chịu trách nhiệm mô tả nội dung và cấu trúc delivery; không sở hữu quyết định adaptive, mastery update, remediation diagnosis hoặc question evaluation.",
        "sourceOfTruth": {
            "knowledge": "knowledge/knowledge-map-v4.json",
            "mastery": "mastery/rules.json",
            "questions": "questions/schema.json",
            "adaptive": "adaptive/rules.json",
            "failureSignatures": "remediation/failure-signatures.json"
        },
        "principle": "Lesson là delivery layer. Lesson mô tả những gì có thể được dạy và cách nội dung được tổ chức; Adaptive Engine quyết định next action, Mastery Engine quyết định mastery, Remediation Engine quyết định remediation strategy, Question Engine/Selector quyết định câu hỏi phù hợp.",
        "coreModel": "cluster_based_learning"
    },
    "ownership": {
        "owns": [
            "lesson_definition",
            "section_structure",
            "content_references",
            "instructional_sequence",
            "question_selection_constraints",
            "delivery_mode_compatibility",
            "lesson_completion_requirements"
        ],
        "doesNotOwn": [
            "knowledge_dependency_truth",
            "target_mastery",
            "mastery_calculation",
            "mastery_promotion",
            "adaptive_next_action",
            "failure_diagnosis",
            "remediation_strategy_selection",
            "question_grading",
            "student_state_persistence"
        ]
    },
    "lessonTypes": {
        "cluster": {
            "name": "Knowledge Cluster",
            "description": "Lesson gom một nhóm knowledge node có quan hệ chặt chẽ."
        },
        "concept": {
            "name": "Concept Lesson",
            "description": "Tập trung xây dựng hoặc củng cố khái niệm."
        },
        "mechanism": {
            "name": "Mechanism Lesson",
            "description": "Tập trung hiểu cơ chế và quan hệ nguyên nhân - kết quả."
        },
        "application": {
            "name": "Application Lesson",
            "description": "Tập trung vận dụng kiến thức."
        },
        "transfer": {
            "name": "Transfer Lesson",
            "description": "Tập trung chuyển giao kiến thức sang ngữ cảnh mới."
        },
        "remediation": {
            "name": "Remediation Lesson",
            "description": "Cung cấp nội dung sửa lỗi cho một hoặc một nhóm failure signature đã được Remediation Engine xác định."
        },
        "review": {
            "name": "Review Lesson",
            "description": "Ôn tập các node đã học."
        },
        "integrated": {
            "name": "Integrated Lesson",
            "description": "Liên kết nhiều knowledge cluster."
        }
    },
    "deliveryModes": {
        "HOC_NHANH": {
            "name": "Học nhanh",
