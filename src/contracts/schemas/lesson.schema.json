        },
        "transfer": {
            "name": "Chuyển giao",
            "purpose": "Áp dụng kiến thức trong ngữ cảnh mới."
        },
        "crossNode": {
            "name": "Liên kết kiến thức",
            "purpose": "Kết nối nhiều knowledge node."
        },
        "remediation": {
            "name": "Sửa lỗi",
            "purpose": "Cung cấp nội dung sửa failure signature đã được xác định bên ngoài Lesson."
        },
        "reflection": {
            "name": "Tự phản tư",
            "purpose": "Giúp học sinh xác định mình đã hiểu gì và còn yếu gì."
        },
        "exitDiagnostic": {
            "name": "Chẩn đoán đầu ra",
            "purpose": "Thu thập evidence sau lesson; Mastery Engine xử lý evidence này."
        },
        "summary": {
            "name": "Tổng kết",
            "purpose": "Củng cố cấu trúc kiến thức."
        }
    },
