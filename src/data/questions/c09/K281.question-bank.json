            ],
            "prerequisites": [
                "K280",
                "K250"
            ],
            "content": {
                "stem": "Hai gene A và B cùng nằm trên một cặp nhiễm sắc thể tương đồng. Trong trường hợp không xảy ra hoán vị gene giữa hai locus A và B, hiện tượng nào sau đây được thể hiện rõ nhất?",
                "context": "Xét sự di truyền của hai gene cùng nằm trên một nhiễm sắc thể.",
                "options": [
                    {
                        "id": "A",
                        "text": "Hai gene có xu hướng được truyền cùng nhau qua các thế hệ tế bào và cơ thể.",
                        "isCorrect": true
                    },
                    {
                        "id": "B",
                        "text": "Hai gene luôn phân li độc lập trong quá trình tạo giao tử.",
                        "isCorrect": false
                    },
                    {
                        "id": "C",
                        "text": "Mỗi gene bắt buộc phải nằm trên một nhiễm sắc thể khác nhau.",
                        "isCorrect": false
                    },
                    {
                        "id": "D",
                        "text": "Hai gene luôn tạo ra bốn loại giao tử với tỉ lệ bằng nhau.",
                        "isCorrect": false
                    }
                ],
                "media": [],
                "data": null
            },
            "answer": {
                "type": "single",
                "value": "A"
            },
            "scoring": {
                "maxScore": 1,
                "partialCredit": false,
                "rubric": null
            },
            "failureSignatures": [
                "concept_confusion"
            ],
            "explanation": {
                "correct": "Các gene cùng nằm trên một nhiễm sắc thể có thể tạo thành nhóm gene liên kết và có xu hướng được di truyền cùng nhau. Khi không xảy ra hoán vị gene giữa hai locus đang xét, các tổ hợp allele trên nhiễm sắc thể bố mẹ được bảo toàn.",
                "incorrect": {
                    "B": "Phân li độc lập đặc trưng cho các cặp gene phân li độc lập; không thể mặc định cho hai gene đang xét cùng nằm trên một nhiễm sắc thể.",
                    "C": "Hai gene hoàn toàn có thể cùng nằm trên một nhiễm sắc thể.",
                    "D": "Bốn loại giao tử bằng nhau không phải hệ quả của liên kết gene hoàn toàn."
                }
            },
            "hint": {
                "enabled": true,
                "levels": [
                    {
                        "level": 1,
                        "text": "Hãy chú ý hai gene đang nằm trên cùng một nhiễm sắc thể."
                    },
                    {
                        "level": 2,
                        "text": "Nếu không có hoán vị gene giữa hai locus, hãy nghĩ xem các tổ hợp allele trên nhiễm sắc thể bố mẹ có bị thay đổi hay không."
                    }
                ]
