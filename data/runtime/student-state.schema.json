{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/runtime/student-state.schema.json",
    "title": "Student State Schema",
    "description": "Central runtime snapshot of the student's current learning state. Stores outputs and projections produced by Mastery, Remediation, Adaptive, runtime orchestration, event projection, progress aggregation, and user/system preferences. Student State owns no mastery calculation, remediation decision, adaptive decision, scheduling, or engine business logic.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "stateId",
        "stateType",
        "updatedAt",
        "student",
        "learning",
        "knowledge",
        "metaSkills",
        "failurePatterns",
        "remediation",
        "adaptive",
        "history",
        "progress",
        "preferences"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "1.1.0"
        },
        "stateId": {
            "type": "string",
            "minLength": 1
        },
        "stateType": {
            "type": "string",
            "const": "runtime"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        },
        "student": {
            "$ref": "#/$defs/student"
        },
        "learning": {
            "$ref": "#/$defs/learning"
        },
        "knowledge": {
            "type": "object",
            "description": "Current Mastery-derived state for knowledge nodes. Object keys are knowledge node IDs.",
            "propertyNames": {
                "pattern": "^K[0-9]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/knowledgeState"
            }
        },
        "metaSkills": {
            "type": "object",
            "description": "Current state for meta-skills. Object keys are meta-skill IDs.",
            "propertyNames": {
                "pattern": "^S[0-9]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/metaSkillState"
            }
        },
        "failurePatterns": {
            "$ref": "#/$defs/failurePatterns"
        },
        "remediation": {
            "$ref": "#/$defs/remediationState"
        },
        "adaptive": {
            "$ref": "#/$defs/adaptiveState"
        },
        "history": {
            "$ref": "#/$defs/historyProjection"
        },
        "progress": {
            "$ref": "#/$defs/progress"
        },
        "preferences": {
            "$ref": "#/$defs/preferences"
        }
    },
    "$defs": {
        "student": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "studentId"
            ],
            "properties": {
                "studentId": {
                    "type": "string",
                    "minLength": 1
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1
                },
                "grade": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                },
                "curriculum": {
                    "type": "string",
                    "enum": [
                        "KNTT",
                        "CTST",
                        "CANH_DIEU",
                        "OTHER"
                    ]
                },
                "target": {
                    "$ref": "#/$defs/studentTarget"
                }
            }
        },
        "studentTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mode": {
                    "$ref": "#/$defs/learningMode"
                },
                "exam": {
                    "type": "string",
                    "minLength": 1
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "learning": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "currentMode",
                "session",
                "current"
            ],
            "properties": {
                "currentMode": {
                    "$ref": "#/$defs/learningMode"
                },
                "session": {
                    "$ref": "#/$defs/sessionRuntime"
                },
                "current": {
                    "$ref": "#/$defs/currentLearningContext"
                }
            }
        },
        "sessionRuntime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sessionId",
                "startedAt",
                "lastActivityAt",
                "timeBudgetMinutes",
                "timeUsedMinutes",
                "runtimeSignals",
                "fatigue"
            ],
            "properties": {
                "sessionId": {
                    "type": "string",
                    "minLength": 1
                },
                "startedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "lastActivityAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "timeBudgetMinutes": {
                    "type": "integer",
                    "minimum": 0
                },
                "timeUsedMinutes": {
                    "type": "integer",
                    "minimum": 0
                },
                "runtimeSignals": {
                    "$ref": "#/$defs/runtimeSignals"
                },
                "fatigue": {
                    "$ref": "#/$defs/fatigue"
                }
            }
        },
        "runtimeSignals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "consecutiveWrong",
                "consecutiveSkip",
                "consecutiveRemediation"
            ],
            "properties": {
                "consecutiveWrong": {
                    "type": "integer",
                    "minimum": 0
                },
                "consecutiveSkip": {
                    "type": "integer",
                    "minimum": 0
                },
                "consecutiveRemediation": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "fatigue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "level",
                "signals"
            ],
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "normal",
                        "elevated",
                        "high"
                    ]
                },
                "signals": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                }
            }
        },
        "currentLearningContext": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "clusterId",
                "lessonId",
                "nodeId",
                "action",
                "contextId"
            ],
            "properties": {
                "clusterId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^C[0-9]+$"
                },
                "lessonId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "nodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "action": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/adaptiveAction"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "contextId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                }
            }
        },
        "knowledgeState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mastery",
                "status",
                "evidence",
                "overallEvidence",
                "confidence",
                "evidenceSufficiency",
                "attemptStats",
                "weakEvidence",
                "signals",
                "lastAttemptAt",
                "lastSuccessAt",
                "lastFailure",
                "retest",
                "review"
            ],
            "properties": {
                "mastery": {
                    "$ref": "#/$defs/masteryLevel"
                },
                "status": {
                    "$ref": "#/$defs/masteryStatus"
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceVector"
                },
                "overallEvidence": {
                    "$ref": "#/$defs/evidenceValue"
                },
                "confidence": {
                    "$ref": "#/$defs/confidenceLevel"
                },
                "evidenceSufficiency": {
                    "$ref": "#/$defs/evidenceSufficiency"
                },
                "attemptStats": {
                    "$ref": "#/$defs/knowledgeAttemptStats"
                },
                "weakEvidence": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidenceDimension"
                    },
                    "uniqueItems": true
                },
                "signals": {
                    "$ref": "#/$defs/signals"
                },
                "lastAttemptAt": {
                    "$ref": "#/$defs/nullableDateTime"
                },
                "lastSuccessAt": {
                    "$ref": "#/$defs/nullableDateTime"
                },
                "lastFailure": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/knowledgeFailure"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "failureSummary": {
                    "$ref": "#/$defs/failureSummary"
                },
                "retest": {
                    "$ref": "#/$defs/retestObservation"
                },
                "review": {
                    "$ref": "#/$defs/reviewObservation"
                }
            }
        },
        "evidenceVector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "know",
                "explain",
                "apply",
                "transfer"
            ],
            "properties": {
                "know": {
                    "$ref": "#/$defs/evidenceValue"
                },
                "explain": {
                    "$ref": "#/$defs/evidenceValue"
                },
                "apply": {
                    "$ref": "#/$defs/evidenceValue"
                },
                "transfer": {
                    "$ref": "#/$defs/evidenceValue"
                }
            }
        },
        "evidenceSufficiency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "independentObservations",
                "distinctContexts",
                "observedEvidenceTypes"
            ],
            "properties": {
                "independentObservations": {
                    "type": "integer",
                    "minimum": 0
                },
                "distinctContexts": {
                    "type": "integer",
                    "minimum": 0
                },
                "observedEvidenceTypes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidenceDimension"
                    },
                    "uniqueItems": true
                }
            }
        },
        "knowledgeAttemptStats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "total",
                "correct",
                "wrong",
                "partial",
                "skipped"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "correct": {
                    "type": "integer",
                    "minimum": 0
                },
                "wrong": {
                    "type": "integer",
                    "minimum": 0
                },
                "partial": {
                    "type": "integer",
                    "minimum": 0
                },
                "skipped": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "knowledgeFailure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "questionId",
                "failureType",
                "sourceNodeId",
                "at"
            ],
            "properties": {
                "questionId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureSignatureId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureType": {
                    "$ref": "#/$defs/failureType"
                },
                "sourceNodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "metaSkillId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^S[0-9]+$"
                },
                "at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "failureSummary": {
            "type": "object",
            "description": "Per-node aggregate projection keyed by canonical failure type.",
            "propertyNames": {
                "enum": [
                    "prerequisite_gap",
                    "concept_confusion",
                    "mechanism_confusion",
                    "calculation_error",
                    "data_interpretation_error",
                    "reasoning_error",
                    "cross_node_reasoning_error",
                    "careless_error",
                    "source_knowledge_gap",
                    "meta_skill_gap"
                ]
            },
            "additionalProperties": {
                "$ref": "#/$defs/failureSummaryItem"
            }
        },
        "failureSummaryItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "count",
                "sourceNodeId",
                "lastAt"
            ],
            "properties": {
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "sourceNodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "lastAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "retestObservation": {
            "type": "object",
            "description": "Observed retest state only. Does not schedule or decide future retests.",
            "additionalProperties": false,
            "required": [
                "attempted",
                "lastRetestAt",
                "passed",
                "differentQuestion",
                "differentContext",
                "independent"
            ],
            "properties": {
                "attempted": {
                    "type": "boolean"
                },
                "lastRetestAt": {
                    "$ref": "#/$defs/nullableDateTime"
                },
                "passed": {
                    "type": "boolean"
                },
                "differentQuestion": {
                    "type": "boolean"
                },
                "differentContext": {
                    "type": "boolean"
                },
                "independent": {
                    "type": "boolean"
                }
            }
        },
        "reviewObservation": {
            "type": "object",
            "description": "Observed review state only. Does not schedule future reviews.",
            "additionalProperties": false,
            "required": [
                "lastReviewedAt"
            ],
            "properties": {
                "lastReviewedAt": {
                    "$ref": "#/$defs/nullableDateTime"
                }
            }
        },
        "metaSkillState": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mastery",
                "status",
                "evidence",
                "confidence",
                "attemptStats",
                "weak",
                "signals",
                "lastFailure"
            ],
            "properties": {
                "mastery": {
                    "$ref": "#/$defs/masteryLevel"
                },
                "status": {
                    "$ref": "#/$defs/masteryStatus"
                },
                "evidence": {
                    "$ref": "#/$defs/evidenceValue"
                },
                "confidence": {
                    "$ref": "#/$defs/confidenceLevel"
                },
                "attemptStats": {
                    "$ref": "#/$defs/metaSkillAttemptStats"
                },
                "weak": {
                    "type": "boolean"
                },
                "signals": {
                    "$ref": "#/$defs/signals"
                },
                "lastFailure": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/metaSkillFailure"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "metaSkillAttemptStats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "total",
                "wrong"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "wrong": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "metaSkillFailure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "questionId",
                "failureType",
                "at"
            ],
            "properties": {
                "questionId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureSignatureId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureType": {
                    "$ref": "#/$defs/failureType"
                },
                "at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "failurePatterns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "active"
            ],
            "properties": {
                "active": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/failurePattern"
                    }
                }
            }
        },
        "failurePattern": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "failureType",
                "nodeId",
                "sourceNodeId",
                "count",
                "lastAt"
            ],
            "properties": {
                "failureSignatureId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureType": {
                    "$ref": "#/$defs/failureType"
                },
                "nodeId": {
                    "type": "string",
                    "pattern": "^K[0-9]+$"
                },
                "sourceNodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "metaSkillId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^S[0-9]+$"
                },
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "lastAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "remediationState": {
            "type": "object",
            "description": "Projection of Remediation Engine output. Student State does not derive or choose remediation.",
            "additionalProperties": false,
            "required": [
                "lastResult",
                "activePlan"
            ],
            "properties": {
                "lastResult": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/remediationResult"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "activePlan": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/remediationPlanReference"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "remediationResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "targetNodeId",
                "sourceNodeId",
                "triggerNodeId",
                "failureType",
                "status",
                "completedAt"
            ],
            "properties": {
                "targetNodeId": {
                    "type": "string",
                    "pattern": "^K[0-9]+$"
                },
                "sourceNodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "triggerNodeId": {
                    "type": "string",
                    "pattern": "^K[0-9]+$"
                },
                "failureSignatureId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureType": {
                    "$ref": "#/$defs/failureType"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "completed",
                        "failed",
                        "cancelled"
                    ]
                },
                "completedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "remediationPlanReference": {
            "type": "object",
            "description": "Reference/projection for a currently active remediation plan. The full remediation plan remains owned by Remediation Engine.",
            "additionalProperties": false,
            "required": [
                "planId",
                "targetNodeId",
                "triggerNodeId",
                "failureType",
                "status"
            ],
            "properties": {
                "planId": {
                    "type": "string",
                    "minLength": 1
                },
                "targetNodeId": {
                    "type": "string",
                    "pattern": "^K[0-9]+$"
                },
                "sourceNodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "triggerNodeId": {
                    "type": "string",
                    "pattern": "^K[0-9]+$"
                },
                "failureSignatureId": {
                    "type": "string",
                    "minLength": 1
                },
                "failureType": {
                    "$ref": "#/$defs/failureType"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "active",
                        "paused"
                    ]
                }
            }
        },
        "adaptiveState": {
            "type": "object",
            "description": "Projection of Adaptive Engine output. Student State stores but does not calculate adaptive decisions.",
            "additionalProperties": false,
            "required": [
                "lastDecision",
                "nextAction"
            ],
            "properties": {
                "lastDecision": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/adaptiveDecision"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "nextAction": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/nextAction"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            }
        },
        "adaptiveDecision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action",
                "nodeId",
                "reasonCodes",
                "at"
            ],
            "properties": {
                "action": {
                    "$ref": "#/$defs/adaptiveAction"
                },
                "nodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "reasonCodes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "nextAction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action",
                "nodeId",
                "priority",
                "constraints",
                "decidedAt"
            ],
            "properties": {
                "action": {
                    "$ref": "#/$defs/adaptiveAction"
                },
                "nodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "priority": {
                    "type": "number"
                },
                "constraints": {
                    "$ref": "#/$defs/adaptiveConstraints"
                },
                "decidedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "adaptiveConstraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "difficulty": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/difficulty"
                    },
                    "uniqueItems": true
                },
                "evidence": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidenceDimension"
                    },
                    "uniqueItems": true
                }
            }
        },
        "historyProjection": {
            "type": "object",
            "description": "Bounded runtime/event projection for convenience. It is not the canonical event log.",
            "additionalProperties": false,
            "required": [
                "recentActions",
                "recentQuestions"
            ],
            "properties": {
                "recentActions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/recentAction"
                    }
                },
                "recentQuestions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "recentAction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action",
                "nodeId",
                "at"
            ],
            "properties": {
                "action": {
                    "$ref": "#/$defs/adaptiveAction"
                },
                "nodeId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^K[0-9]+$"
                },
                "at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "nodes",
                "clusters"
            ],
            "properties": {
                "nodes": {
                    "$ref": "#/$defs/nodeProgress"
                },
                "clusters": {
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^C[0-9]+$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/clusterProgress"
                    }
                }
            }
        },
        "nodeProgress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "total",
                "unstarted",
                "developing",
                "mastered",
                "stable"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "unstarted": {
                    "type": "integer",
                    "minimum": 0
                },
                "developing": {
                    "type": "integer",
                    "minimum": 0
                },
                "mastered": {
                    "type": "integer",
                    "minimum": 0
                },
                "stable": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "clusterProgress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "progress"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "not_started",
                        "in_progress",
                        "mastered",
                        "stable"
                    ]
                },
                "progress": {
                    "$ref": "#/$defs/evidenceValue"
                }
            }
        },
        "preferences": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "preferredSessionLength",
                "preferredDifficulty",
                "allowChallenge",
                "allowSkipKnown",
                "showDetailedFeedback"
            ],
            "properties": {
                "preferredSessionLength": {
                    "type": "string",
                    "enum": [
                        "short",
                        "normal",
                        "long"
                    ]
                },
                "preferredDifficulty": {
                    "type": "string",
                    "enum": [
                        "adaptive",
                        "easier",
                        "harder"
                    ]
                },
                "allowChallenge": {
                    "type": "boolean"
                },
                "allowSkipKnown": {
                    "type": "boolean"
                },
                "showDetailedFeedback": {
                    "type": "boolean"
                }
            }
        },
        "learningMode": {
            "type": "string",
            "enum": [
                "HOC_NHANH",
                "HOC_SAU",
                "ON_THI"
            ]
        },
        "adaptiveAction": {
            "type": "string",
            "enum": [
                "LEARN",
                "PRACTICE",
                "CHALLENGE",
                "REMEDIATE",
                "RETEST",
                "REVIEW",
                "SKIP"
            ]
        },
        "masteryLevel": {
            "type": "string",
            "enum": [
                "M0",
                "M1",
                "M2",
                "M3",
                "M4"
            ]
        },
        "masteryStatus": {
            "type": "string",
            "enum": [
                "developing",
                "mastered",
                "stable",
                "weak"
            ]
        },
        "confidenceLevel": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high"
            ]
        },
        "evidenceDimension": {
            "type": "string",
            "enum": [
                "know",
                "explain",
                "apply",
                "transfer"
            ]
        },
        "evidenceValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "difficulty": {
            "type": "string",
            "enum": [
                "D1",
                "D2",
                "D3",
                "D4",
                "D5"
            ]
        },
        "failureType": {
            "type": "string",
            "enum": [
                "prerequisite_gap",
                "concept_confusion",
                "mechanism_confusion",
                "calculation_error",
                "data_interpretation_error",
                "reasoning_error",
                "cross_node_reasoning_error",
                "careless_error",
                "source_knowledge_gap",
                "meta_skill_gap"
            ]
        },
        "signals": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "nullableDateTime": {
            "oneOf": [
                {
                    "type": "string",
                    "format": "date-time"
                },
                {
                    "type": "null"
                }
            ]
        }
    }
}