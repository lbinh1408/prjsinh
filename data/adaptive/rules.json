        "maximumAlternatives": 2,
        "examples": [
            "PRACTICE",
            "REMEDIATE"
        ]
    },
    "studentChoiceRules": {
        "principle": "Adaptive system định hướng nhưng không khóa cứng học sinh.",
        "allowedChoices": [
            "continue_recommended",
            "choose_review",
            "choose_challenge",
            "choose_different_node"
