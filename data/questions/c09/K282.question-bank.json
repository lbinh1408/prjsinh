                    {
                        "id": "A",
                        "text": "AB và ab.",
                        "isCorrect": true
                    },
                    {
                        "id": "B",
                        "text": "Ab và aB.",
                        "isCorrect": false
                    },
                    {
                        "id": "C",
                        "text": "AB và Ab.",
                        "isCorrect": false
                    },
                    {
                        "id": "D",
                        "text": "aB và ab.",
                        "isCorrect": false
                    }
                ],
                "media": [],
                "data": null
            },
            "answer": {
                "type": "single",
                "value": "A"
            },
            "scoring": {
                "maxScore": 1,
                "partialCredit": false,
                "rubric": null
            },
            "failureSignatures": [
                "concept_confusion"
            ],
            "explanation": {
                "correct": "Ở kiểu sắp xếp AB/ab, hai tổ hợp allele ban đầu trên hai nhiễm sắc thể tương đồng là AB và ab. Vì vậy AB và ab là các loại giao tử mang tổ hợp allele bố mẹ; Ab và aB là các tổ hợp tái tổ hợp nếu chúng được tạo ra.",
                "incorrect": {
                    "B": "Ab và aB là các tổ hợp allele mới so với hai tổ hợp AB và ab ban đầu.",
                    "C": "Ab không phải tổ hợp allele bố mẹ trong kiểu sắp xếp AB/ab.",
                    "D": "aB không phải tổ hợp allele bố mẹ trong kiểu sắp xếp AB/ab."
                }
