    "nodeMappingRules": {
        "primaryNode": {
            "required": true,
            "rule": "Phải là knowledge node mà câu hỏi trực tiếp đo mastery."
        },
        "secondaryNodes": {
            "required": false,
            "rule": "Các knowledge node hỗ trợ, prerequisite liên quan hoặc được sử dụng trong quá trình giải. secondaryNodes không mặc định nhận mastery evidence từ câu hỏi."
        },
        "nodes": {
            "required": true,
            "rule": "nodes chứa các knowledge node được câu hỏi trực tiếp đo evidence. primaryNode bắt buộc phải thuộc nodes. secondaryNodes không bắt buộc thuộc nodes.",
            "primaryNodeMustBeIncluded": true,
            "secondaryNodesAutoIncluded": false
        },
        "multiNodeQuestion": {
            "rule": "Một câu có thể trực tiếp đo nhiều knowledge node và khi đó các node được đo phải xuất hiện trong nodes, nhưng chỉ có một primaryNode. Việc phân phối evidence cho các node khác ngoài primaryNode phải do Mastery contract quy định rõ, không được suy ra chỉ từ secondaryNodes."
        }
    },
