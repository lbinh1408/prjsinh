        "content": {
            "stem": "Một quần thể có tần số hoán vị gene là 20%. Tỉ lệ giao tử tái tổ hợp được tạo ra là bao nhiêu?",
            "context": null,
            "options": [
                {
                    "id": "A",
                    "text": "10%",
                    "isCorrect": false
                },
                {
                    "id": "B",
                    "text": "20%",
                    "isCorrect": true
                },
                {
                    "id": "C",
                    "text": "40%",
                    "isCorrect": false
                },
                {
                    "id": "D",
                    "text": "80%",
                    "isCorrect": false
                }
            ],
            "media": [],
            "data": null
        },
        "answer": {
            "type": "single",
            "value": "B"
        },
        "scoring": {
            "maxScore": 1,
            "partialCredit": false,
            "rubric": null
        },
        "failureSignatures": [
            "recombination-rate-calculation",
            "linked-gamete-confusion"
        ],
        "explanation": {
            "correct": "Tần số hoán vị gene chính là tỉ lệ giao tử tái tổ hợp được tạo ra. Vì vậy tần số hoán vị 20% tương ứng 20% giao tử tái tổ hợp.",
            "incorrect": {
                "A": "Có thể đã chia đôi tần số hoán vị khi không cần thiết.",
                "C": "Có thể đã nhân đôi tần số hoán vị.",
                "D": "Có thể nhầm tỉ lệ giao tử liên kết với giao tử tái tổ hợp."
            }
        },
        "hint": {
            "enabled": true,
            "levels": [
                {
                    "level": 1,
                    "text": "Hãy nhớ định nghĩa của tần số hoán vị gene."
                },
                {
                    "level": 2,
                    "text": "Tần số hoán vị gene được tính từ tỉ lệ giao tử nào?"
                }
            ]
        },
