        "exitDiagnostic": {
            "enabled": true,
            "questionSelection": {
                "source": "questions/",
                "selection": {
                    "nodes": [
                        "K200",
                        "K204",
                        "K206",
                        "K208"
                    ],
                    "evidence": [
                        "know",
                        "explain",
                        "apply",
                        "transfer"
                    ],
                    "difficulty": [
                        "D2",
                        "D3",
                        "D4"
                    ],
                    "count": 6
                }
            },
            "outcomes": {
                "mastered": {
                    "action": "UPDATE_MASTERY"
                },
                "partial": {
                    "action": "PRACTICE_GAP"
                },
                "weak": {
                    "action": "REMEDIATE"
                }
            }
        },
        "adaptiveRules": {
            "enabled": true,
            "skip": {
                "condition": "node.mastery >= node.targetMastery",
                "action": "skip_section"
            },
            "learn": {
                "condition": "node.mastery <= M1",
                "action": "show_concept_and_guided_practice"
            },
            "practice": {
                "condition": "node.mastery == M2",
                "action": "show_practice"
            },
            "challenge": {
                "condition": "node.mastery == M3",
                "action": "show_apply_and_transfer"
            },
            "retest": {
                "condition": "node.mastery == M4",
                "action": "show_retest"
            },
            "remediate": {
                "condition": "node.status == weak",
                "action": "route_to_failure_signature"
            }
        },
        "estimatedMinutes": {
            "minimum": 35,
            "typical": 90,
            "maximum": 150
        },
        "difficulty": "adaptive",
        "metadata": {
            "author": "system",
            "createdAt": "2026-09-20",
            "updatedAt": "2026-09-20",
            "reviewStatus": "approved",
            "tags": [
                "dna",
                "gene",
                "rna",
                "protein",
                "trait"
            ]
        }
    },
    "nodeRules": {
        "multipleNodesPerLesson": true,
        "nodeCanAppearInMultipleLessons": true,
        "primaryNode": {
            "required": false,
            "rule": "Chỉ bắt buộc khi lesson có mục tiêu mastery cụ thể."
        },
        "supportingNode": {
            "rule": "Node hỗ trợ có thể xuất hiện trong lesson mà không phải mục tiêu chính."
        },
        "targetMastery": {
            "source": "knowledge-map-v4.json",
            "rule": "Lesson không được tự đặt targetMastery khác với Knowledge Map."
        }
    },
    "sectionRules": {
        "sequenceIsFlexible": true,
        "principle": "Section sequence có thể thay đổi theo delivery mode và mastery.",
        "minimumLearningFlow": [
            "concept_or_observation",
            "guidedPractice",
            "application_or_transfer"
        ],
        "deepLearningFlow": [
            "orientation",
            "concept",
            "mechanism",
            "workedExample",
            "guidedPractice",
            "apply",
            "crossNode",
            "transfer",
            "reflection",
            "exitDiagnostic"
        ],
        "fastLearningFlow": [
            "entryDiagnostic",
            "learn_gap",
            "practice",
            "challenge",
            "exitDiagnostic"
        ]
    },
    "questionSetRules": {
        "principle": "Lesson tham chiếu question bank bằng selection rule thay vì hard-code toàn bộ câu hỏi.",
        "selectionMayUse": [
            "node",
            "primaryNode",
            "evidence",
            "difficulty",
            "mode",
            "skill",
            "failureSignature",
            "contextType",
            "retestGroupId"
        ],
        "adaptiveSelection": true,
        "avoidRepeatedQuestions": true,
        "avoidImmediateDuplicateContext": true
    },
    "diagnosticRules": {
        "entryDiagnostic": {
            "purpose": "Xác định điểm bắt đầu.",
            "doesNotEqualMasteryTest": true,
            "maySkipContent": true
        },
        "exitDiagnostic": {
            "purpose": "Đánh giá tiến bộ sau lesson.",
            "updatesMastery": true
        },
        "rule": "Diagnostic phải ngắn hơn một bài kiểm tra thông thường."
    },
    "adaptiveLearningRules": {
        "principle": "Lesson structure là dynamic theo mastery.",
        "M0": {
            "show": [
                "concept",
                "observation",
                "mechanism",
                "guidedPractice"
            ],
            "skip": [
                "advanced_transfer"
            ]
        },
        "M1": {
            "show": [
                "concept",
                "mechanism",
                "guidedPractice",
                "practice"
            ]
        },
        "M2": {
            "show": [
                "brief_concept_review",
                "practice",
                "apply"
            ],
            "skip": [
                "long_introduction"
            ]
        },
        "M3": {
            "show": [
                "apply",
                "crossNode",
                "transfer"
            ],
            "skip": [
                "basic_concept_explanation"
            ]
        },
        "M4": {
            "show": [
                "challenge",
                "transfer",
                "retest"
            ],
            "skip": [
                "basic_teaching"
            ]
        },
        "stable": {
            "show": [
                "review",
                "challenge"
            ],
            "skip": [
                "full_lesson"
            ]
        }
    },
    "remediationLessonRules": {
        "principle": "Remediation lesson nhỏ, tập trung vào failure signature thay vì dạy lại toàn bộ cluster.",
        "requiredFields": [
            "targetFailureSignature",
            "sourceNodes",
            "miniLesson",
            "miniPractice",
            "miniProbe"
        ],
        "recommendedFlow": [
            "identify_error",
            "explain_source",
            "guided_practice",
            "mini_probe",
            "return_to_original_node"
        ],
        "maximumNodes": 3,
        "maximumEstimatedMinutes": 20
    },
    "transferRules": {
        "principle": "Transfer section phải thay đổi bối cảnh, dữ kiện hoặc cách biểu diễn.",
        "acceptableChanges": [
            "new_context",
            "new_data",
            "new_representation",
            "cross_node_problem",
            "reverse_reasoning",
            "real_world_scenario"
        ],
        "notTransfer": [
            "same_question_with_numbers_changed",
            "same_example_reworded",
            "simple_recall"
        ]
    },
    "contentRules": {
        "lessonShouldNot": [
            "copy_entire_textbook_chapter",
            "repeat_same_explanation_multiple_times",
            "force_every_student_through_every_section",
            "define_mastery_independently",
            "hard_code_student_specific_next_action"
        ],
        "lessonShould": [
            "teach_mechanisms",
            "connect_nodes",
            "provide_examples",
            "provide_scaffolding",
            "support_adaptive_skipping",
            "provide_transfer",
            "provide_self_reflection"
        ]
    },
    "lessonCompletionRules": {
        "principle": "Hoàn thành lesson không đồng nghĩa mastery.",
        "completionMeans": [
            "student_completed_required_sections",
            "student_attempted_required_questions"
        ],
        "masteryMeans": [
            "mastery_rules_passed"
        ]
    },
    "analyticsContract": {
        "lessonEvents": [
            "lesson_started",
            "diagnostic_started",
            "section_started",
            "section_completed",
            "section_skipped",
            "question_answered",
            "remediation_triggered",
            "lesson_completed",
            "exit_diagnostic_completed"
        ],
        "lessonDoesNotStoreStudentState": true,
        "rule": "Student state được lưu bởi Student State / Analytics layer, không lưu trực tiếp trong lesson definition."
    },
    "validationRules": {
        "mustValidate": [
            "all node IDs exist in knowledge-map-v4.json",
            "all question references match questions/schema.json",
            "all evidence values are valid",
            "all difficulty values are valid",
            "all section types are valid",
            "all delivery modes are valid"
        ],
        "mustNotValidateAgainst": [
            "student mastery",
            "student progress",
            "current adaptive decision"
        ],
        "principle": "Lesson schema kiểm tra tính hợp lệ của lesson definition, không kiểm tra trạng thái cá nhân của học sinh."
    },
    "versioning": {
        "currentVersion": "1.0.0",
        "compatibleKnowledgeMap": "4.x",
        "compatibleMasteryRules": "1.x",
        "compatibleQuestionSchema": "1.x",
        "breakingChanges": [
            "Thay đổi cấu trúc section bắt buộc.",
            "Thay đổi meaning của delivery mode.",
            "Thay đổi contract giữa Lesson Engine và Adaptive Engine."
        ],
        "nonBreakingChanges": [
            "Thêm section type.",
            "Thêm metadata.",
            "Thêm content format.",
            "Thêm adaptive rule."
        ]
    }
}