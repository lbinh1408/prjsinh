        "domain": "J",
        "deliveryModes": [
            "HOC_NHANH",
            "HOC_SAU",
            "ON_THI"
        ],
        "knowledgeNodes": [
            "K200",
            "K201",
            "K204",
            "K205",
            "K202",
            "K206",
            "K208"
