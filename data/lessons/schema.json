            },
            {
                "id": "OBJ04",
                "node": "K208",
                "type": "transfer",
                "description": "Suy luận mối liên hệ DNA → RNA → protein → tính trạng trong ngữ cảnh mới."
            }
        ],
        "entryDiagnostic": {
            "enabled": true,
