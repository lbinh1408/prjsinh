{
    "schemaVersion": "1.0.0",
    "schemaId": "biology-lesson-schema-v1",
    "subject": "biology",
    "language": "vi",
    "status": "final",
    "purpose": {
        "description": "Schema chuẩn cho các lesson học Sinh học theo knowledge node và mastery.",
        "sourceOfTruth": {
            "knowledge": "knowledge/knowledge-map-v4.json",
            "mastery": "mastery/rules.json",
            "questions": "questions/schema.json"
        },
        "principle": "Lesson là lớp delivery. Lesson không quyết định học sinh cần học knowledge node nào; Knowledge Map và Adaptive Engine quyết định.",
        "coreModel": "cluster_based_learning"
    },
    "lessonTypes": {
        "cluster": {
            "name": "Knowledge Cluster",
            "description": "Lesson gom một nhóm knowledge node có quan hệ chặt chẽ."
        },
        "concept": {
            "name": "Concept Lesson",
            "description": "Tập trung xây dựng hoặc củng cố khái niệm."
        },
        "mechanism": {
            "name": "Mechanism Lesson",
            "description": "Tập trung hiểu cơ chế và quan hệ nguyên nhân - kết quả."
        },
        "application": {
            "name": "Application Lesson",
            "description": "Tập trung vận dụng kiến thức."
        },
        "transfer": {
            "name": "Transfer Lesson",
            "description": "Tập trung chuyển giao kiến thức sang ngữ cảnh mới."
        },
        "remediation": {
            "name": "Remediation Lesson",
            "description": "Sửa một hoặc một nhóm failure signature cụ thể."
        },
        "review": {
            "name": "Review Lesson",
            "description": "Ôn tập các node đã học."
        },
        "integrated": {
            "name": "Integrated Lesson",
            "description": "Liên kết nhiều knowledge cluster."
        }
    },
    "deliveryModes": {
        "HOC_NHANH": {
            "name": "Học nhanh",
            "description": "Diagnostic → bỏ qua phần đã vững → học gap → practice → mastery check."
        },
        "HOC_SAU": {
            "name": "Học sâu",
            "description": "Concept → mechanism → apply → transfer → cross-node → retest."
        },
        "ON_THI": {
            "name": "Ôn thi",
            "description": "Question → diagnose → remediate → retry → retest."
        }
    },
    "sectionTypes": {
        "orientation": {
            "name": "Định hướng",
            "purpose": "Cho học sinh biết mình sẽ học gì và vì sao."
        },
        "entryDiagnostic": {
            "name": "Chẩn đoán đầu vào",
            "purpose": "Xác định điểm bắt đầu."
        },
        "concept": {
            "name": "Khái niệm",
            "purpose": "Xây dựng kiến thức nền."
        },
        "observation": {
            "name": "Quan sát",
            "purpose": "Khởi tạo nhận thức từ ví dụ, dữ liệu hoặc hiện tượng."
        },
        "comparison": {
            "name": "So sánh",
            "purpose": "Phân biệt các khái niệm hoặc cơ chế."
        },
        "mechanism": {
            "name": "Cơ chế",
            "purpose": "Giải thích cách thức một quá trình diễn ra."
        },
        "workedExample": {
            "name": "Ví dụ mẫu",
            "purpose": "Cho thấy cách suy luận hoặc giải bài."
        },
        "guidedPractice": {
            "name": "Luyện tập có hướng dẫn",
            "purpose": "Luyện với scaffolding."
        },
        "practice": {
            "name": "Luyện tập",
            "purpose": "Củng cố kiến thức."
        },
        "apply": {
            "name": "Vận dụng",
            "purpose": "Áp dụng kiến thức vào vấn đề."
        },
        "transfer": {
            "name": "Chuyển giao",
            "purpose": "Áp dụng trong ngữ cảnh mới."
        },
        "crossNode": {
            "name": "Liên kết kiến thức",
            "purpose": "Kết nối nhiều knowledge node."
        },
        "remediation": {
            "name": "Sửa lỗi",
            "purpose": "Xử lý failure signature."
        },
        "reflection": {
            "name": "Tự phản tư",
            "purpose": "Giúp học sinh xác định mình đã hiểu gì và còn yếu gì."
        },
        "exitDiagnostic": {
            "name": "Chẩn đoán đầu ra",
            "purpose": "Kiểm tra mức mastery sau lesson."
        },
        "summary": {
            "name": "Tổng kết",
            "purpose": "Củng cố cấu trúc kiến thức."
        }
    },
    "coreSchema": {
        "required": [
            "id",
            "version",
            "title",
            "type",
            "deliveryModes",
            "knowledgeNodes",
            "sections"
        ],
        "optional": [
            "description",
            "domain",
            "prerequisites",
            "entryDiagnostic",
            "exitDiagnostic",
            "estimatedMinutes",
            "difficulty",
            "objectives",
            "adaptiveRules",
            "metadata"
        ]
    },
    "lessonObject": {
